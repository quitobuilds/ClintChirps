import Anthropic from '@anthropic-ai/sdk';
import { CLINT_PERSONA, TARGETS, SCHIZO_TOPICS, REPLY_STYLES } from './personality';

const anthropic = new Anthropic();

interface TweetContext {
  username: string;
  text: string;
  tweetId: string;
}

function getTargetContext(username: string): string {
  const handle = username.toLowerCase();
  const target = TARGETS[handle as keyof typeof TARGETS];
  
  if (!target) {
    return 'unknown target. be generally snarky but not too harsh.';
  }

  return `
target: ${target.name} (${target.fullName})
role: ${target.role}
their quirks you can play on: ${target.quirks.join(', ')}
topics to potentially roast: ${target.topicsToRoast.join(', ')}
`.trim();
}

function pickRandom<T>(arr: T[]): T {
  return arr[Math.floor(Math.random() * arr.length)];
}

export async function generateReply(tweet: TweetContext): Promise<string> {
  const targetContext = getTargetContext(tweet.username);
  const style = pickRandom(REPLY_STYLES);

  const prompt = `${CLINT_PERSONA}

---

you need to reply to this tweet from @${tweet.username}:

"${tweet.text}"

context about this person:
${targetContext}

suggested style for this reply: ${style}

generate a single reply tweet. remember:
- keep it short (under 280 chars, ideally under 200)
- lowercase unless heated
- no emojis unless ironic
- don't be actually mean, be clever
- don't explain the joke
- match clint's voice exactly

respond with ONLY the tweet text, nothing else.`;

  const response = await anthropic.messages.create({
    model: 'claude-sonnet-4-20250514',
    max_tokens: 150,
    messages: [{ role: 'user', content: prompt }],
  });

  const text = response.content[0].type === 'text' ? response.content[0].text : '';
  
  // clean up any quotes the model might add
  return text.replace(/^["']|["']$/g, '').trim();
}

export async function generateSchizoTweet(): Promise<string> {
  const topic = pickRandom(SCHIZO_TOPICS);
  
  const prompt = `${CLINT_PERSONA}

---

time to post an unprompted thought. you're in schizo mode.

topic inspiration (but don't be too literal): ${topic}

generate a standalone tweet. this isn't a reply to anyone, just clint sharing his thoughts with the timeline.

could be:
- a vague observation that solana people will understand
- commentary on something that happened recently in crypto
- a rhetorical question
- an old man yells at cloud moment about the industry
- a callback to old crypto lore
