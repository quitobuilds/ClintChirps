respond with ONLY the tweet text, nothing else.`;

  const response = await anthropic.messages.create({
    model: 'claude-sonnet-4-20250514',
    max_tokens: 150,
    messages: [{ role: 'user', content: prompt }],
  });

  const text = response.content[0].type === 'text' ? response.content[0].text : '';
  
  return text.replace(/^["']|["']$/g, '').trim();
}

export async function shouldReply(tweet: TweetContext): Promise<boolean> {
  // don't reply to every tweet - that's annoying
  // use llm to decide if this tweet is worth engaging with
  
  const prompt = `you are deciding whether clint should reply to this tweet.

tweet from @${tweet.username}:
"${tweet.text}"

clint should reply if:
- the tweet is roastable (bad take, fumble, contradiction, flex, etc)
- there's something clever to say
- it's a moment worth commenting on

clint should NOT reply if:
- it's just a normal informational tweet
- it's about something serious/sad
- it's genuinely good content with nothing to roast
- replying would be punching down or actually mean

respond with ONLY "yes" or "no"`;

  const response = await anthropic.messages.create({
    model: 'claude-sonnet-4-20250514',
    max_tokens: 10,
    messages: [{ role: 'user', content: prompt }],
  });

  const text = response.content[0].type === 'text' ? response.content[0].text.toLowerCase().trim() : 'no';
  
  return text.includes('yes');
}

export async function decideResponseType(tweet: TweetContext): Promise<'reply' | 'quote' | 'skip'> {
  // sometimes a quote tweet hits different than a reply
  
  const prompt = `you are deciding how clint should respond to this tweet.

tweet from @${tweet.username}:
"${tweet.text}"

options:
- "reply" - respond directly in the replies
- "quote" - quote tweet it (better for when you want your followers to see the roast)
- "skip" - don't engage with this one

quote tweets are better for:
- particularly spicy takes that deserve wider attention
- when the roast needs the original context to land
- moments worth archiving

replies are better for:
- quick jabs
- conversational engagement
- when you don't want to seem like you're trying too hard

respond with ONLY one word: "reply", "quote", or "skip"`;

  const response = await anthropic.messages.create({
    model: 'claude-sonnet-4-20250514',
    max_tokens: 10,
    messages: [{ role: 'user', content: prompt }],
  });

  const text = response.content[0].type === 'text' ? response.content[0].text.toLowerCase().trim() : 'skip';
  
  if (text.includes('quote')) return 'quote';
  if (text.includes('reply')) return 'reply';
  return 'skip';
}
